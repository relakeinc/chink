# Conexion a PostgreSQL (servicio local postgresql-x64-17).
# En Docker compose la BD la pone el servicio `db` (ver docker-compose.yml).
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/chink_saas?schema=public"
POSTGRES_USER="chinksaas"
POSTGRES_PASSWORD=""
POSTGRES_DB="chinksaas"

# API
PORT=3100
HOST=127.0.0.1
JWT_SECRET="cambia-esto-en-produccion"

# Frontend (Vite). Se deja vacio para usar el proxy de /api
VITE_API_URL=""

# R2 (fotos de producto). La subida va directa del navegador al bucket con URL firmada.
R2_ACCOUNT_ID=""
R2_BUCKET=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_PUBLIC_BASE_URL="https://tu-dominio-publico-r2"

# Correo transaccional con el SMTP propio del VPS (dype-mail).
# En local se usa por el túnel SSH (scripts/dev.ps1 lo levanta solo):
#   127.0.0.1:2525 -> 172.17.0.1:587 del VPS.
# En el VPS apunta directo a 172.17.0.1:587.
SMTP_HOST="127.0.0.1"
SMTP_PORT="2525"
SMTP_SECURE="false"
SMTP_USER="pz@mail.relake.co"
SMTP_PASS=""
APP_URL="http://127.0.0.1:5173"
EMAIL_FROM_INVITATIONS="pz@mail.relake.co"
EMAIL_FROM_VERIFICATION="pz@verify.relake.co"
EMAIL_FROM_NOTIFICATIONS="pz@notify.relake.co"
EMAIL_FROM_ALERTS="pz@alerts.relake.co"
EMAIL_FROM_REPORTS="pz@reports.relake.co"

# Pagos por Telegram (opcional; sin esto, comprobantes solo manuales).
# Crea el bot con BotFather y pega aquí el token + un secreto para el webhook.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_SECRET_TOKEN=""
TELEGRAM_BOT_USERNAME=""

# Gemini para OCR de comprobantes (hasta 3 keys con rotación automática).
GEMINI_API_KEY_1=""
GEMINI_API_KEY_2=""
GEMINI_API_KEY_3=""
# Modelo de visión (rápido y barato por defecto).
GEMINI_MODEL="gemini-2.5-flash-lite"
# Reserva si Google retira el primario (coma-separados, se prueban en orden).
GEMINI_FALLBACK_MODELS="gemini-2.5-flash-lite,gemini-flash-lite-latest"
// Esquema de datos de chink-saas.
// Cubre las siete pantallas: Inicio, Inventario, Movimientos, Almacenes,
// Reportes, Equipo y Configuración.
// Todos los importes monetarios se guardan en COP.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  IN_STOCK
  LOW_STOCK
}

enum MemberStatus {
  ACTIVE
  PENDING
}

enum MovementType {
  ENTRY
  EXIT
  TRANSFER
  ADJUSTMENT
}

enum MovementStatus {
  CONFIRMED
  PENDING
}

// ------------------------------------------------------------------ Equipo

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  name         String
  initials     String
  roleId       String
  role         Role         @relation(fields: [roleId], references: [id])
  status       MemberStatus @default(ACTIVE)
  /// Espacio de trabajo al que pertenece: propio al registrarse o el del equipo que invita.
  workspaceId  String
  invitedAt    DateTime?
  lastAccessAt DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  warehouses        UserWarehouse[]
  movements         StockMovement[]
  ownedWarehouses   Warehouse[]      @relation("WarehouseOwner")
  settingsUpdates   WorkspaceSetting[]
  memberships       SpaceMember[]
  notifications     Notification[]
  telegramChats     TelegramChat[]
  registeredPagos   Pago[]           @relation("PagoRegistradoPor")
  linkCodes         CodigoVinculacion[] @relation("CodigoCreador")

  @@index([workspaceId])
  @@map("users")
}

model Role {
  id    String @id @default(cuid())
  name  String @unique
  users User[]

  permissions RolePermission[]
  memberships SpaceMember[]

  @@map("roles")
}

model Permission {
  id    String @id @default(cuid())
  key   String @unique
  label String
  order Int    @default(0)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  allowed      Boolean @default(false)

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

/// Almacenes a los que tiene acceso cada miembro.
model UserWarehouse {
  userId      String
  warehouseId String

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@id([userId, warehouseId])
  @@map("user_warehouses")
}

// --------------------------------------------------------------- Inventario

model Warehouse {
  id           String  @id @default(cuid())
  /// Código único dentro de cada espacio (cada cuenta tiene su propia serie).
  code         String
  name         String
  location     String
  address      String
  capacity     Int
  active       Boolean @default(true)
  position     Int     @default(0)
  responsibleId String?
  /// Espacio dueño del almacén.
  workspaceId  String

  responsible User?           @relation("WarehouseOwner", fields: [responsibleId], references: [id], onDelete: SetNull)
  locations   StockLocation[]
  members     UserWarehouse[]
  origins     StockMovement[] @relation("MovementOrigin")
  destinations StockMovement[] @relation("MovementDestination")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workspaceId, code])
  @@index([workspaceId])
  @@map("warehouses")
}

model Product {
  id         String        @id @default(cuid())
  /// SKU único dentro de cada espacio.
  sku        String
  name       String
  category   String
  stock      Int           @default(0)
  reserved   Int           @default(0)
  unitCost   Decimal       @db.Decimal(14, 2)
  totalValue Decimal       @db.Decimal(16, 2)
  status     ProductStatus @default(IN_STOCK)
  archived   Boolean       @default(false)
  /// Orden de salida por defecto de la tabla (el diseño define un orden fijo)
  position   Int           @default(0)
  /// Clave del icono en apps/web/src/assets/icons (sin extensión)
  icon       String        @default("package")
  /// Objeto en R2 con la foto del producto y su URL pública.
  imageKey   String?
  imageUrl   String?
  minStock   Int           @default(0)
  /// Espacio dueño del producto.
  workspaceId String

  locations StockLocation[]
  movements StockMovement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([status])
  @@index([archived])
  @@unique([workspaceId, sku])
  @@index([workspaceId])
  @@map("products")
}

/// Existencias de un producto en cada almacén (pantalla "Existencias por ubicación").
model StockLocation {
  productId   String
  warehouseId String
  quantity    Int    @default(0)
  reserved    Int    @default(0)

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@id([productId, warehouseId])
  @@map("stock_locations")
}

// -------------------------------------------------------------- Movimientos

model StockMovement {
  id            String         @id @default(cuid())
  /// Referencia correlativa dentro de cada espacio (MOV-001…).
  ref           String
  type          MovementType
  status        MovementStatus @default(CONFIRMED)
  quantity      Int
  note          String?
  productId     String
  product       Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  originId      String?
  destinationId String?
  ownerId       String
  /// Espacio dueño del movimiento.
  workspaceId   String
  createdAt     DateTime       @default(now())

  origin      Warehouse? @relation("MovementOrigin", fields: [originId], references: [id], onDelete: SetNull)
  destination Warehouse? @relation("MovementDestination", fields: [destinationId], references: [id], onDelete: SetNull)
  owner       User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([type])
  @@unique([workspaceId, ref])
  @@index([workspaceId])
  @@map("stock_movements")
}

// ----------------------------------------------------------- Configuración

/// Preferencias de cada espacio de trabajo. Hay una fila por espacio y su
/// id ES el workspaceId (la fila "default" es el espacio original).
model WorkspaceSetting {
  id           String @id
  spaceName    String
  /// Color del avatar del espacio, en hexadecimal (se elige en Configuración).
  spaceColor   String @default("#242722")
  /// Icono del espacio (galería `workspace-*` en assets/icons, sin extensión).
  spaceMark    String @default("workspace-mark")
  /// Tema visual: "auto" (halloween en temporada), "light" o "halloween" forzado.
  theme        String @default("auto")
  legalName    String
  contactEmail String
  taxId        String
  language     String
  currency     String
  timezone     String
  dateFormat   String
  unit         String
  defaultWarehouseId String?
  movementPrefix     String
  defaultMinStock    Int

  allowNegativeStock    Boolean @default(false)
  requireAdjustmentReason Boolean @default(true)
  lowStockAlerts           Boolean @default(true)
  reserveBeforePicking    Boolean @default(true)

  /// Preferencias de avisos del espacio.
  notifyLowStock     Boolean @default(true)
  notifyMovements    Boolean @default(true)
  notifyWeeklyReport Boolean @default(false)

  updatedById String?
  updatedBy   User?   @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  updatedAt   DateTime @updatedAt
  members     SpaceMember[]
  clientes    Cliente[]
  pagos       Pago[]
  telegramChats TelegramChat[]
  linkCodes   CodigoVinculacion[]

  @@map("workspace_settings")
}

/// Pertenencia a espacios: un usuario puede estar en varios (el propio al
/// registrarse más los equipos que lo inviten). El rol es por espacio.
model SpaceMember {
  userId      String
  workspaceId String
  roleId      String
  status      MemberStatus @default(ACTIVE)
  createdAt   DateTime     @default(now())

  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace WorkspaceSetting @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role      Role             @relation(fields: [roleId], references: [id])

  @@id([userId, workspaceId])
  @@index([workspaceId])
  @@map("space_members")
}

/// Avisos dentro de la app (invitaciones a espacios, etc.).
model Notification {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String?
  kind        String   @default("invite")
  title       String
  body        String
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@map("notifications")
}

// ------------------------------------------------------------------- Pagos

/// Clientes del espacio (para asociar comprobantes de pago).
model Cliente {
  id             String   @id @default(cuid())
  workspaceId    String
  workspace      WorkspaceSetting @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  nombre         String
  numeroContacto String?
  notas          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  pagos Pago[]

  @@index([workspaceId])
  @@map("clientes")
}

/// Comprobante de pago registrado por OCR del bot o a mano.
/// La referencia es única por espacio: así no hay duplicados.
model Pago {
  id             String        @id @default(cuid())
  workspaceId    String
  workspace      WorkspaceSetting @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clienteId      String?
  cliente        Cliente?      @relation(fields: [clienteId], references: [id], onDelete: SetNull)
  telegramChatId String?
  telegramChat   TelegramChat? @relation(fields: [telegramChatId], references: [id], onDelete: SetNull)
  registradoPorId String?
  registradoPor  User?         @relation("PagoRegistradoPor", fields: [registradoPorId], references: [id], onDelete: SetNull)
  estado         String        @default("verificado")
  para           String?
  numeroDestino  String?
  bancoDestino   String?
  fechaPago      DateTime?
  horaPago       String?
  monto          Decimal       @db.Decimal(14, 2)
  referencia     String?
  numeroOrigen   String?
  fuenteFondos   String?
  imageKey       String?
  imageUrl       String?
  rawJson        Json?
  notas          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([workspaceId, referencia])
  @@index([workspaceId])
  @@index([workspaceId, estado])
  @@map("pagos")
}

/// Chat de Telegram vinculado a un espacio (uno por cuenta de Telegram y espacio).
model TelegramChat {
  id          String   @id @default(cuid())
  workspaceId String
  workspace   WorkspaceSetting @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  usuarioId   String
  usuario     User     @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  chatId      BigInt
  apodo       String?
  activo      Boolean  @default(true)
  ultimoUso   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  pagos Pago[]

  @@unique([workspaceId, chatId])
  @@index([usuarioId])
  @@map("telegram_chats")
}

/// Código corto (6 dígitos, 10 min, un uso) para vincular Telegram desde la app.
/// Solo lo genera quien tiene permiso de registro; el bot lo canjea con /vincular.
model CodigoVinculacion {
  id          String    @id @default(cuid())
  codigo      String    @unique
  workspaceId String
  workspace   WorkspaceSetting @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creadoPorId String
  creadoPor   User      @relation("CodigoCreador", fields: [creadoPorId], references: [id], onDelete: Cascade)
  expiraEn    DateTime
  usadoEn     DateTime?
  createdAt   DateTime  @default(now())

  @@index([workspaceId])
  @@map("codigos_vinculacion")
}